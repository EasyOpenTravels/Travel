/* Immersive personal workspaces: keep My Stuff feeling like a native app. */
body.personal-route-body .topbar,
body.personal-route-body .footer { display:none !important; }
body.personal-route-body > main {
  width:100%;
  max-width:none;
  margin:0;
  padding:0;
}
body.personal-route-body .journal-v5,
body.personal-route-body .color-cards-app,
body.personal-route-body .saves-v5 {
  min-height:100svh;
}

@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Space+Grotesk:wght@500;600;700&display=swap');
:root{--ink:#12212b;--muted:#5f6b73;--cream:#fbf6ea;--paper:#fffdf7;--line:#d9d3c5;--lime:#d8f36a;--orange:#ff8b4c;--aqua:#77e1d2;--pink:#ff8fb6;--blue:#87b8ff;--shadow:0 22px 50px rgba(18,33,43,.10);--radius:24px}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--cream);color:var(--ink);font-family:'DM Sans',system-ui,sans-serif;line-height:1.5}a{text-decoration:none;color:inherit}button,input,textarea,select{font:inherit}.topbar{position:sticky;top:0;z-index:30;display:grid;grid-template-columns:auto minmax(240px,1fr) auto;align-items:center;gap:22px;padding:12px clamp(14px,4vw,42px);background:rgba(251,246,234,.94);backdrop-filter:blur(15px);border-bottom:1px solid rgba(18,33,43,.08)}.brand{display:flex;gap:10px;align-items:center;font-weight:800;letter-spacing:.08em;font-size:12px}.brand-mark{display:grid;place-items:center;width:38px;height:38px;border-radius:12px;background:var(--ink);color:#fff}.search{display:flex;max-width:680px;margin:auto;width:100%;background:#fff;border:1px solid var(--line);border-radius:16px;padding:4px}.search input{border:0;background:transparent;padding:11px 12px;min-width:0}.search input:focus{outline:0}.search button{border:0;background:var(--ink);color:#fff;border-radius:12px;width:44px}.topbar nav{display:flex;gap:14px;align-items:center;font-size:13px;font-weight:700}.topbar nav a{padding:9px}.nav-hot{background:var(--lime);border-radius:12px}.hero{max-width:1440px;margin:auto;padding:52px clamp(18px,5vw,76px) 42px;display:grid;grid-template-columns:1fr 1fr;gap:54px;align-items:center}.eyebrow{font-size:11px;letter-spacing:.16em;font-weight:800;text-transform:uppercase;color:#4e5a62}.hero-copy h1,.detail-copy h1,.trip-big-copy h1,.account-hero h1,.search-hero h1,.form-card h1,.booking-success h1{font-family:'Space Grotesk',sans-serif;font-size:clamp(48px,6.4vw,88px);line-height:.94;letter-spacing:-.05em;margin:14px 0}.hero-copy p,.lead{font-size:19px;color:var(--muted);max-width:700px}.hero-actions{display:flex;flex-wrap:wrap;gap:15px;align-items:center;margin-top:27px}.button{display:inline-flex;justify-content:center;align-items:center;border:0;border-radius:14px;padding:13px 18px;font-weight:800;cursor:pointer}.button.primary{background:var(--ink);color:#fff;box-shadow:5px 5px 0 var(--orange)}.button.secondary{background:#fff;border:1px solid var(--ink)}.button.light{background:#fff;color:var(--ink)}.button.small{padding:9px 12px;font-size:12px}.button.full{width:100%}.text-link{font-weight:800;border-bottom:2px solid var(--ink);padding-bottom:2px}.hero-proof{display:flex;gap:18px;flex-wrap:wrap;margin-top:34px;font-size:12px;color:var(--muted)}.hero-proof b{display:block;font:700 22px 'Space Grotesk';color:var(--ink)}.hero-collage{position:relative;min-height:520px}.photo{position:absolute;border-radius:30px;border:8px solid var(--paper);background-size:cover;background-position:center;box-shadow:var(--shadow)}.photo-a{inset:0 20% 12% 0;background-image:url('https://commons.wikimedia.org/wiki/Special:FilePath/Diani_Beach,_Kenya.jpg')}.photo-b{width:47%;height:44%;right:0;bottom:0;background-image:url('https://commons.wikimedia.org/wiki/Special:FilePath/Kenya,_Hell%27s_Gate_(45282893295).jpg')}.route-board{position:absolute;top:8%;right:5%;background:var(--lime);padding:18px 18px 14px;border:3px solid var(--ink);border-radius:18px;transform:rotate(4deg);box-shadow:7px 7px 0 var(--ink)}.route-board span,.route-board small{display:block;font-size:10px;font-weight:800;letter-spacing:.1em}.route-board b{display:block;font:700 27px 'Space Grotesk';margin:2px 0}.road-drawing{position:absolute;left:8%;bottom:7%;width:55%;height:75px;background:var(--ink);border-radius:100px 100px 16px 16px;transform:skew(-13deg);border:6px solid var(--paper)}.road-drawing span{display:block;height:5px;background:var(--lime);margin:31px 22px;box-shadow:80px 0 var(--lime),160px 0 var(--lime),240px 0 var(--lime)}.stats{max-width:1320px;margin:0 auto;padding:0 18px 44px;display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.stats>div{padding:22px;background:#fff;border:1px solid var(--line);border-radius:18px}.stats strong{font:700 37px 'Space Grotesk';display:block}.stats span{font-size:12px;color:var(--muted)}.section{max-width:1400px;margin:auto;padding:70px clamp(18px,5vw,70px)}.dark-section{max-width:none;padding-left:max(18px,calc((100vw - 1260px)/2));padding-right:max(18px,calc((100vw - 1260px)/2));background:var(--ink);color:#fff}.inverse .eyebrow,.inverse p{color:#aebdc7}.section-head{display:flex;justify-content:space-between;gap:20px;align-items:end;margin-bottom:26px}.section-head h2,.feature-grid h2,.cta-band h2{font:700 clamp(34px,4.2vw,60px) 'Space Grotesk';line-height:1;letter-spacing:-.04em;margin:8px 0}.section-head p{color:var(--muted);max-width:470px}.trip-grid,.destination-grid,.post-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.trip-card,.destination-card,.post-card{background:#fff;border:1px solid var(--line);border-radius:22px;overflow:hidden;transition:transform .18s ease,box-shadow .18s ease}.dark-section .destination-card{background:#172934;border-color:#29414d}.trip-card:hover,.destination-card:hover,.post-card:hover{transform:translateY(-5px);box-shadow:var(--shadow)}.trip-image,.destination-image{height:255px;background-size:cover;background-position:center;position:relative}.trip-image:after,.destination-image:after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,transparent 50%,rgba(0,0,0,.54))}.trip-badge{position:absolute;left:14px;top:14px;z-index:1;background:var(--lime);color:var(--ink);padding:8px 10px;border-radius:11px;font-size:11px;font-weight:800}.trip-body,.destination-body,.post-card>div:last-child{padding:19px}.trip-body h3,.destination-body h3,.post-card h3{font:700 29px 'Space Grotesk';margin:0}.trip-body p,.destination-body p,.post-card p{color:var(--muted);min-height:45px}.dark-section .destination-body p{color:#afbdc4}.card-cta,.destination-arrow{display:inline-block;font-weight:800;margin-top:10px}.destination-body{color:#fff}.bright-section{background:linear-gradient(135deg,var(--lime),var(--aqua));max-width:none}.feature-grid{max-width:1320px;margin:auto;display:grid;grid-template-columns:1fr 1fr;gap:55px;align-items:start}.feature-list{display:grid;gap:10px}.feature-list div{display:grid;grid-template-columns:55px 1fr;gap:15px;padding:18px;border:2px solid var(--ink);border-radius:17px;background:rgba(255,255,255,.34)}.feature-list b{font-family:'Space Grotesk'}.post-image{height:210px;background-size:cover;background-position:center}.cta-band{max-width:1320px;margin:40px auto 90px;padding:36px;border:3px solid var(--ink);border-radius:28px;background:var(--orange);display:flex;justify-content:space-between;gap:24px;align-items:center;box-shadow:10px 10px 0 var(--ink)}.footer{max-width:1320px;margin:auto;padding:42px 18px 60px;border-top:1px solid var(--line);display:grid;grid-template-columns:1.4fr .8fr .8fr;gap:28px;color:var(--muted);font-size:13px}.footer b,.footer-brand{display:block;color:var(--ink);font-weight:800;margin-bottom:8px}.footer a,.footer span{display:block;margin-top:5px}.detail-hero,.trip-detail{max-width:1400px;margin:auto;padding:35px clamp(18px,5vw,75px) 60px;display:grid;grid-template-columns:1.1fr .9fr;gap:40px;align-items:center}.detail-photo,.trip-big-photo{min-height:600px;border-radius:32px;background-size:cover;background-position:center;box-shadow:var(--shadow);border:8px solid #fff}.detail-copy,.trip-big-copy{padding:25px 8px}.tag-row{display:flex;flex-wrap:wrap;gap:8px;margin:24px 0}.tag-row span{padding:9px 12px;background:var(--ink);color:#fff;border-radius:100px;font-size:12px}.detail-note{padding:18px;border-left:4px solid var(--orange);background:#fff;border-radius:12px}.fact-strip,.booking-summary{display:grid;grid-template-columns:repeat(3,1fr);border:1px solid var(--line);border-radius:17px;overflow:hidden;background:#fff;margin:27px 0}.fact-strip div,.booking-summary div{padding:15px;border-right:1px solid var(--line)}.fact-strip div:last-child,.booking-summary div:last-child{border-right:0}.fact-strip span,.booking-summary span,.ticket-grid span{display:block;font-size:10px;color:var(--muted);letter-spacing:.1em}.price-reveal{display:flex;align-items:end;gap:10px;margin-bottom:18px}.price-reveal span{font-size:11px;font-weight:800}.price-reveal strong{font:700 36px 'Space Grotesk'}.price-reveal small{color:var(--muted)}.unlock-card{background:var(--lime);border:2px solid var(--ink);border-radius:20px;padding:20px;box-shadow:7px 7px 0 var(--ink)}.content-split{max-width:1100px;margin:auto;padding:0 18px 85px;display:grid;grid-template-columns:1.3fr .7fr;gap:55px}.content-split h2{font:700 31px 'Space Grotesk';margin-top:35px}.preline{white-space:pre-line;color:#59656d;line-height:1.8}.side-card{background:#fff;border:1px solid var(--line);padding:23px;border-radius:22px;margin-top:30px}.side-card.bright{background:var(--aqua)}.photo-credit{max-width:1320px;margin:auto;padding:0 18px 40px;font-size:11px;color:var(--muted)}.form-page{min-height:70vh;display:grid;place-items:center;padding:50px 18px}.form-card,.booking-success{width:min(760px,100%);background:#fff;border:1px solid var(--line);border-radius:25px;padding:clamp(24px,5vw,50px);box-shadow:var(--shadow)}.form-card.wide,.booking-success.wide{width:min(1000px,100%)}form{display:grid;gap:15px;margin-top:22px}label{display:grid;gap:7px;font-size:13px;font-weight:800}input,textarea,select{width:100%;border:1px solid #cfc9bd;border-radius:13px;padding:13px 14px;background:#fff;outline:none}input:focus,textarea:focus,select:focus{border-color:var(--ink);box-shadow:0 0 0 4px rgba(216,243,106,.35)}.field-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:13px}.micro{font-size:11px;color:var(--muted);line-height:1.5}.flash{position:fixed;z-index:80;right:16px;top:82px;background:#fff;border:1px solid var(--line);padding:13px 16px;border-radius:14px;box-shadow:var(--shadow);max-width:380px}.flash.error{border-color:#d75143}.flash.success{border-color:#57a47c}.booking-head{display:flex;justify-content:space-between;align-items:center;background:var(--cream);border:1px solid var(--line);padding:18px;border-radius:17px}.booking-head b,.booking-head span{display:block}.booking-price{font:700 27px 'Space Grotesk'}.booking-price small{font:12px 'DM Sans';font-weight:500}.payment-help,.payment-box{background:var(--aqua);border:1px solid var(--ink);padding:16px;border-radius:17px}.payment-help b,.payment-help span{display:block}.status-banner{padding:15px;border-radius:14px;margin:20px 0}.status-banner.awaiting_payment{background:#fff0b0}.status-banner.payment_submitted{background:#dce8ff}.status-banner.paid,.status-banner.confirmed{background:#d7f3d0}.status-banner.cancelled{background:#ffd3d3}.payment-line{display:flex;justify-content:space-between;padding:11px 0;border-bottom:1px dashed rgba(18,33,43,.2)}.ticket-area{margin-top:26px}.ticket-row,.my-booking,.message-card{display:flex;justify-content:space-between;gap:16px;align-items:center;background:#fff;border:1px solid var(--line);border-radius:17px;padding:14px;margin-top:10px}.ticket-row span,.my-booking p,.message-card span{display:block;color:var(--muted);font-size:12px}.ticket-page{padding:60px 18px}.ticket-card{width:min(760px,100%);margin:auto;padding:30px;border:3px solid var(--ink);border-radius:28px;background:#fff;box-shadow:10px 10px 0 var(--lime)}.ticket-brand{font-weight:800;letter-spacing:.1em}.ticket-status{display:inline-block;margin-top:14px;padding:8px 10px;border-radius:9px;font-size:11px;font-weight:800}.ticket-status.good{background:var(--lime)}.ticket-status.pending{background:#ffe6a4}.ticket-card h1{font:700 55px 'Space Grotesk';margin:55px 0 4px}.ticket-grid{display:grid;grid-template-columns:1fr 1fr;border:1px solid var(--line);margin-top:25px}.ticket-grid div{padding:16px;border-bottom:1px solid var(--line);border-right:1px solid var(--line)}.ticket-qr{display:block;width:min(300px,80%);margin:32px auto}.center{text-align:center}.scan-card{width:min(650px,100%);text-align:center;background:#fff;border:3px solid var(--ink);border-radius:28px;padding:50px}.scan-card.valid{box-shadow:10px 10px 0 var(--lime)}.scan-card.invalid{box-shadow:10px 10px 0 var(--pink)}.big-state{font:700 48px 'Space Grotesk'}.account-hero{max-width:1320px;margin:auto;padding:55px 18px 32px;display:flex;justify-content:space-between;gap:22px;align-items:end}.account-badge{background:var(--ink);color:#fff;border-radius:22px;padding:19px 22px;min-width:220px}.account-badge span,.account-badge small{display:block;font-size:10px;letter-spacing:.11em;color:#b6c6ce}.account-badge strong{display:block;font:700 43px 'Space Grotesk';margin:4px 0}.account-wrap{max-width:1320px;margin:auto;padding:0 18px 65px;display:grid;grid-template-columns:1.4fr .6fr;gap:22px}.section-mini-head{display:flex;justify-content:space-between;align-items:center}.section-mini-head h2{font:700 35px 'Space Grotesk'}.my-booking{padding:0;overflow:hidden}.my-booking-photo{width:190px;min-height:150px;background-size:cover;background-position:center}.my-booking-copy{padding:18px;flex:1}.account-side{display:grid;gap:14px;align-content:start}.account-card{background:#fff;border:1px solid var(--line);border-radius:22px;padding:23px}.account-card.dark{background:var(--ink);color:#fff}.account-card.warm{background:var(--orange)}.account-card a{display:block;margin-top:10px}.account-card p{color:var(--muted)}.account-card.dark p,.account-card.dark span{color:#b8c4c9}.danger-link{border:0;background:transparent;color:#a33;font-size:12px;font-weight:800;padding:0;margin-top:18px}.search-hero{max-width:1000px;margin:auto;padding:80px 18px 40px;text-align:center}.search-hero p{color:var(--muted)}.big-search{display:grid;grid-template-columns:1fr auto;gap:10px;max-width:760px;margin:30px auto}.big-search input{padding:17px;border-radius:16px}.post-detail{max-width:1200px;margin:auto;padding:45px 18px 90px;display:grid;grid-template-columns:1fr 1fr;gap:45px;align-items:center}.post-detail-image{min-height:560px;background-size:cover;background-position:center;border-radius:30px;border:8px solid #fff;box-shadow:var(--shadow)}.post-detail-copy h1{font:700 58px 'Space Grotesk';line-height:.96}.empty{padding:25px;border:1px dashed var(--line);border-radius:18px;background:#fff}.empty.large{padding:45px}.admin-body{background:#e8e4da}.admin-top{position:sticky;top:0;z-index:30;display:flex;justify-content:space-between;align-items:center;gap:18px;padding:12px 18px;background:var(--ink);color:#fff}.admin-top nav{display:flex;flex-wrap:wrap;gap:9px;font-size:11px;font-weight:700}.admin-top nav a{padding:8px 9px;border-radius:9px}.admin-top nav a:hover{background:#24404c}.admin-wrap{max-width:1400px;margin:auto;padding:38px 18px 80px}.admin-hero{display:flex;justify-content:space-between;gap:20px;align-items:end}.admin-hero h1{font:700 55px 'Space Grotesk';margin:10px 0}.admin-quick,.button-row{display:flex;gap:10px;flex-wrap:wrap}.admin-stats{display:grid;grid-template-columns:repeat(6,1fr);gap:10px;margin:26px 0}.admin-stats>div{background:#fff;border:1px solid var(--line);padding:16px;border-radius:16px}.admin-stats b{font:700 29px 'Space Grotesk';display:block}.admin-stats span{font-size:11px;color:var(--muted)}.admin-grid-two{display:grid;grid-template-columns:1fr 1fr;gap:16px}.admin-panel{background:#fff;border:1px solid var(--line);border-radius:20px;padding:20px;margin-top:16px}.panel-head{display:flex;justify-content:space-between;gap:15px;align-items:end}.panel-head h2{font:700 27px 'Space Grotesk';margin:5px 0}.admin-row{border-top:1px solid var(--line);padding:13px 0;display:flex;justify-content:space-between;gap:15px;align-items:center}.admin-row b,.admin-row span{display:block}.admin-row span{font-size:11px;color:var(--muted)}.row-actions{display:flex;gap:10px;flex-wrap:wrap;font-size:11px;font-weight:800}.table-wrap{overflow:auto}.table-wrap table{width:100%;border-collapse:collapse;background:#fff}th,td{text-align:left;padding:12px;border-bottom:1px solid var(--line);white-space:nowrap}th{font-size:11px;color:var(--muted)}.help-list{line-height:2}.danger{color:#a33}
@media(max-width:1050px){.topbar{grid-template-columns:auto 1fr}.topbar nav{display:none}.hero,.detail-hero,.trip-detail,.content-split,.account-wrap,.post-detail,.feature-grid{grid-template-columns:1fr}.hero-collage{min-height:420px}.trip-grid,.destination-grid,.post-grid{grid-template-columns:1fr 1fr}.admin-stats{grid-template-columns:repeat(3,1fr)}}
@media(max-width:700px){.topbar{grid-template-columns:auto 1fr;gap:10px}.search{grid-column:1/-1;grid-row:2}.hero{padding-top:28px}.hero h1,.detail-copy h1,.trip-big-copy h1,.account-hero h1,.search-hero h1,.form-card h1{font-size:51px}.hero-collage{min-height:350px}.photo-a{inset:0 10% 15% 0}.photo-b{width:46%;height:41%}.stats{grid-template-columns:1fr}.section{padding:52px 14px}.section-head{display:block}.section-head .button{margin-top:14px}.trip-grid,.destination-grid,.post-grid{grid-template-columns:1fr}.trip-image,.destination-image{height:240px}.field-grid,.fact-strip,.booking-summary{grid-template-columns:1fr}.fact-strip div,.booking-summary div{border-right:0;border-bottom:1px solid var(--line)}.detail-photo,.trip-big-photo{min-height:330px}.content-split{padding:0 14px 55px}.footer{grid-template-columns:1fr}.cta-band{margin:20px 14px 55px;display:grid;padding:25px}.account-hero{display:block;padding:32px 14px 20px}.account-badge{margin-top:20px}.my-booking{display:block}.my-booking-photo{width:100%;height:190px}.admin-top{align-items:start;flex-direction:column}.admin-top nav{width:100%;overflow:auto;flex-wrap:nowrap}.admin-hero{display:block}.admin-hero h1{font-size:42px}.admin-grid-two{grid-template-columns:1fr}.admin-stats{grid-template-columns:1fr 1fr}.ticket-card h1,.post-detail-copy h1{font-size:43px}.ticket-grid{grid-template-columns:1fr}.big-search{grid-template-columns:1fr}.flash{left:14px;right:14px;max-width:none}.route-board{right:0}.road-drawing{width:70%}}

/* Mobile-first adventure polish */
.mobile-nav-actions{display:none}.live-tag{position:absolute;right:4%;bottom:2%;z-index:5;background:var(--pink);color:var(--ink);padding:8px 11px;border:2px solid var(--ink);border-radius:999px;font-size:10px;font-weight:800;transform:rotate(-3deg)}.live-collage .photo-a,.live-collage .photo-b{transition:background-image .8s ease,transform .8s ease}.share-strip{max-width:1320px;margin:25px auto 0;padding:28px 30px;border:2px solid var(--ink);border-radius:24px;background:var(--aqua);display:flex;justify-content:space-between;gap:25px;align-items:center;box-shadow:8px 8px 0 var(--ink)}.share-strip h2{font:700 clamp(30px,4vw,48px) 'Space Grotesk';line-height:1;margin:8px 0}.share-strip p{color:#3c555e;margin:0;max-width:600px}.share-actions{display:flex;gap:10px;flex-wrap:wrap;align-items:center}.join-page{min-height:76vh;display:grid;place-items:center;padding:40px 16px}.join-card{width:min(620px,100%);text-align:center;background:#fff;border:1px solid var(--line);border-radius:28px;padding:32px;box-shadow:var(--shadow)}.join-card h1{font:700 clamp(42px,8vw,70px) 'Space Grotesk';line-height:.95;letter-spacing:-.05em;margin:12px 0}.join-qr{margin:26px auto;width:min(320px,80vw);aspect-ratio:1;display:grid;place-items:center;background:#fff;padding:18px;border:2px solid var(--ink);border-radius:22px}.join-qr img{width:100%;height:100%;object-fit:contain}.join-card .micro{overflow-wrap:anywhere}.pwa-note{position:fixed;left:14px;right:14px;bottom:14px;z-index:60;display:none;justify-content:space-between;gap:14px;align-items:center;padding:13px 15px;background:var(--ink);color:#fff;border-radius:17px;box-shadow:0 10px 30px rgba(0,0,0,.22)}.pwa-note b{display:block}.pwa-note span{font-size:11px;color:#c9d5da}.pwa-note button{border:0;background:var(--lime);color:var(--ink);padding:9px 12px;border-radius:11px;font-weight:800}
@media(max-width:700px){.desktop-nav{display:none}.mobile-nav-actions{display:block;justify-self:end}.mobile-register{display:inline-flex;align-items:center;min-height:40px;padding:0 12px;border-radius:12px;background:var(--lime);font-weight:900;font-size:12px;border:2px solid var(--ink)}.brand-mark{width:34px;height:34px}.brand{font-size:11px}.topbar{grid-template-columns:auto auto}.search{grid-column:1/-1}.hero-actions .button,.hero-actions .text-link{width:100%;justify-content:center;text-align:center}.hero-proof{gap:10px}.share-strip{margin:0 14px;padding:23px;display:grid;box-shadow:6px 6px 0 var(--ink)}.share-actions{display:grid;grid-template-columns:1fr 1fr}.share-actions .button{width:100%}.share-strip h2{font-size:34px}.live-tag{font-size:8px;right:0}.join-card{padding:25px 18px}.join-card .share-actions{grid-template-columns:1fr}.footer{padding-bottom:90px}}

/* Open Road service menu + event layer */
.menu-button{display:grid;place-items:center;width:40px;height:40px;border:1px solid var(--line);background:#fff;border-radius:12px;gap:4px;padding:8px;cursor:pointer}.menu-button span{display:block;width:20px;height:2px;background:var(--ink);border-radius:2px}.road-menu{position:fixed;inset:0;z-index:100;pointer-events:none}.road-menu.open{pointer-events:auto}.road-menu-shade{position:absolute;inset:0;background:rgba(18,33,43,.48);opacity:0;transition:.2s}.road-drawer{position:absolute;left:0;top:0;bottom:0;width:min(430px,92vw);background:var(--cream);border-right:1px solid var(--line);transform:translateX(-105%);transition:transform .28s ease;overflow:auto;padding:22px}.road-menu.open .road-menu-shade{opacity:1}.road-menu.open .road-drawer{transform:translateX(0);box-shadow:18px 0 55px rgba(18,33,43,.18)}.drawer-top{display:flex;justify-content:space-between;gap:16px;align-items:start}.drawer-top h2{font:700 36px 'Space Grotesk';line-height:.98;margin:6px 0 0;letter-spacing:-.04em}.drawer-close{border:1px solid var(--line);background:#fff;border-radius:12px;width:40px;height:40px;font-size:25px;cursor:pointer}.drawer-note{margin:16px 0 14px;padding:12px 14px;background:#fff;border:1px dashed var(--line);border-radius:14px;font-size:12px;color:var(--muted)}.drawer-list{display:grid;gap:9px}.drawer-feature{display:grid;grid-template-columns:35px 1fr;gap:12px;padding:14px;border-radius:17px;border:2px solid var(--ink);align-items:center;transition:transform .15s ease,box-shadow .15s ease}.drawer-feature:hover{transform:translateX(4px);box-shadow:5px 5px 0 var(--ink)}.drawer-feature>span{font:700 12px 'Space Grotesk'}.drawer-feature b{display:block;font:700 18px 'Space Grotesk'}.drawer-feature small{display:block;font-size:11px;color:#4d5a61;margin-top:2px}.drawer-feature.lime{background:var(--lime)}.drawer-feature.aqua{background:var(--aqua)}.drawer-feature.orange{background:var(--orange)}.drawer-feature.pink{background:var(--pink)}.drawer-feature.blue{background:var(--blue)}.drawer-feature.yellow{background:#ffe26e}.drawer-feature.teal{background:#78d8c9}.drawer-feature.white{background:#fff}.drawer-bottom{margin-top:16px;padding:14px;border-top:1px solid var(--line);font-size:11px;color:var(--muted)}.menu-lock{overflow:hidden}.services-hero{max-width:1400px;margin:auto;padding:50px clamp(18px,5vw,70px) 70px;display:grid;grid-template-columns:1fr .9fr;gap:50px;align-items:center}.services-hero h1{font:700 clamp(50px,6vw,84px) 'Space Grotesk';line-height:.93;letter-spacing:-.05em;margin:12px 0}.service-poster{position:relative;min-height:460px;overflow:hidden;background:linear-gradient(145deg,var(--aqua),var(--lime));border:3px solid var(--ink);border-radius:34px;box-shadow:12px 12px 0 var(--ink)}.poster-card{position:absolute;padding:18px 19px;border:3px solid var(--ink);border-radius:17px;background:#fff;box-shadow:7px 7px 0 var(--ink);font-size:12px;letter-spacing:.1em}.poster-card strong{font:700 27px 'Space Grotesk';letter-spacing:-.03em}.poster-one{top:11%;left:9%;transform:rotate(-6deg);background:var(--pink)}.poster-two{top:32%;right:8%;transform:rotate(5deg);background:var(--orange)}.poster-three{bottom:17%;left:21%;transform:rotate(-3deg);background:var(--lime)}.poster-road{position:absolute;left:0;right:-8%;bottom:-18%;height:180px;background:var(--ink);transform:rotate(-7deg);border-top:7px solid #fff}.poster-road:after{content:"";position:absolute;left:8%;right:8%;top:82px;border-top:6px dashed var(--lime)}.service-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}.service-card{display:grid;grid-template-columns:42px 1fr;gap:12px;padding:17px;border:2px solid var(--ink);border-radius:20px;background:#fff;transition:transform .17s ease,box-shadow .17s ease}.service-card:hover{transform:translateY(-4px);box-shadow:7px 7px 0 var(--ink)}.service-card.lime{background:var(--lime)}.service-card.aqua{background:var(--aqua)}.service-card.orange{background:var(--orange)}.service-card.pink{background:var(--pink)}.service-card.blue{background:var(--blue)}.service-card.yellow{background:#ffe26e}.service-card.teal{background:#78d8c9}.service-card.white{background:#fff}.service-icon{display:grid;place-items:center;width:42px;height:42px;background:var(--ink);color:#fff;border-radius:12px;font:700 13px 'Space Grotesk'}.service-card .pill{display:inline-block;margin-bottom:7px;background:rgba(255,255,255,.65);color:var(--ink)}.service-card h3{font:700 22px 'Space Grotesk';line-height:1.02;margin:0}.service-card p{font-size:12px;color:#4d5a61;margin:8px 0}.service-card small{font-size:10px;font-weight:800;letter-spacing:.03em}.ticket-service{display:grid;grid-template-columns:1.1fr .9fr;gap:18px;border:2px solid var(--ink);border-radius:26px;overflow:hidden;background:#fff;box-shadow:9px 9px 0 var(--pink)}.ticket-service-copy{padding:32px}.ticket-service-copy h3{font:700 clamp(34px,4vw,54px) 'Space Grotesk';line-height:.98;margin:0 0 12px}.ticket-service-visual{position:relative;min-height:310px;background:linear-gradient(145deg,var(--pink),var(--orange));border-left:2px solid var(--ink);display:grid;place-items:center}.ticket-stamp{width:150px;height:150px;display:grid;place-items:center;text-align:center;border:5px solid var(--ink);border-radius:50%;font:700 22px 'Space Grotesk';transform:rotate(-8deg);box-shadow:8px 8px 0 var(--ink);background:var(--lime)}.ticket-lines{position:absolute;left:10%;right:10%;bottom:35px;height:45px;border-top:3px solid var(--ink);border-bottom:3px solid var(--ink)}.dark-note{background:#1c3440;border:2px solid #42606e;border-radius:20px;padding:25px}.dark-note p{color:#aebdc7}.check-row{display:flex;grid-template-columns:none;align-items:flex-start;gap:9px}.check-row input{width:auto;margin-top:4px}.search-subhead{font:700 26px 'Space Grotesk';margin:48px 0 16px}
@media(max-width:1050px){.service-grid{grid-template-columns:1fr 1fr}.services-hero,.ticket-service{grid-template-columns:1fr}.ticket-service-visual{border-left:0;border-top:2px solid var(--ink)}}
@media(max-width:700px){.menu-button{width:38px;height:38px}.road-drawer{padding:16px}.drawer-top h2{font-size:31px}.services-hero{padding:32px 14px 45px}.services-hero h1{font-size:49px}.service-poster{min-height:360px}.service-grid{grid-template-columns:1fr}.ticket-service-copy{padding:23px}.ticket-service-visual{min-height:240px}}

.request-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px}.request-card{background:#fff;border:1px solid var(--line);border-radius:19px;padding:18px;display:flex;justify-content:space-between;gap:15px;align-items:end}.request-card h3{font:700 23px 'Space Grotesk';margin:9px 0 4px}.request-card p{font-size:12px;color:var(--muted);margin:0}.request-card>b{font-size:11px;white-space:nowrap}
@media(max-width:700px){.request-grid{grid-template-columns:1fr}.request-card{display:block}.request-card>b{display:block;margin-top:15px}}


/* Revisited navigation + ticketing + My Stuff polish */
.drawer-sections{display:grid;gap:10px}.drawer-section{border:2px solid var(--ink);border-radius:18px;background:#fff;overflow:hidden}.drawer-section:nth-child(1){background:var(--lime)}.drawer-section:nth-child(2){background:var(--pink)}.drawer-section:nth-child(3){background:var(--aqua)}.drawer-section:nth-child(4){background:var(--orange)}.drawer-section:nth-child(5){background:#ffe26e}.drawer-section summary{list-style:none;cursor:pointer;display:grid;grid-template-columns:38px 1fr auto;gap:10px;align-items:center;padding:15px}.drawer-section summary::-webkit-details-marker{display:none}.drawer-section summary:after{content:'+';display:grid;place-items:center;width:26px;height:26px;border-radius:9px;background:var(--ink);color:#fff;font-weight:900;font-size:18px}.drawer-section[open] summary:after{content:'−'}.drawer-section-no{font:700 12px 'Space Grotesk'}.drawer-section summary b{display:block;font:700 18px 'Space Grotesk'}.drawer-section summary small{display:block;font-size:10px;color:#4f5e65;margin-top:2px}.drawer-nested{display:grid;gap:6px;padding:0 12px 12px 60px}.drawer-nested a{padding:9px 10px;border-radius:10px;background:rgba(255,255,255,.7);font-size:12px;font-weight:800}.drawer-nested a:hover{background:#fff;transform:translateX(2px)}
.ticket-style-choice{display:grid;grid-template-columns:1fr 1fr;gap:12px}.ticket-style-choice label{display:block;cursor:pointer}.ticket-style-choice input{position:absolute;opacity:0;pointer-events:none}.ticket-style-choice span{display:block;padding:16px;border:2px solid var(--ink);border-radius:17px;background:#fff}.ticket-style-choice input:checked+span{background:var(--lime);box-shadow:5px 5px 0 var(--ink)}.ticket-style-choice b{display:block;font:700 20px 'Space Grotesk'}.ticket-style-choice small{display:block;color:var(--muted);font-size:11px;margin-top:4px}.event-owner-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin:15px 0 24px}.event-owner-stats>div{background:#fff;border:1px solid var(--line);border-radius:16px;padding:16px}.event-owner-stats b{display:block;font:700 30px 'Space Grotesk'}.event-owner-stats span{font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:.08em}.tier-option{display:block;cursor:pointer}.tier-option input{position:absolute;opacity:0}.tier-option span{display:grid;gap:4px;padding:14px;border:2px solid var(--ink);border-radius:14px;background:#fff;height:100%}.tier-option input:checked+span{background:var(--lime);box-shadow:4px 4px 0 var(--ink)}.tier-option b{font-size:10px;letter-spacing:.1em}.tier-option strong{font:700 24px 'Space Grotesk'}.payment-instructions{margin-top:18px;padding:16px;border-radius:16px;background:var(--cream);border:1px dashed var(--line)}.payment-instructions p{margin:6px 0 0;white-space:pre-line;color:var(--muted)}.saves-v4-top-actions{display:flex;gap:8px;align-items:center}.stuff-tool-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:15px}.stuff-tool-btn{min-height:180px;display:flex;flex-direction:column;justify-content:end;padding:20px;border:2px solid var(--ink);border-radius:22px;box-shadow:7px 7px 0 var(--ink);transition:transform .15s ease}.stuff-tool-btn:hover{transform:translateY(-4px)}.stuff-tool-btn strong{font:700 30px 'Space Grotesk';line-height:1}.stuff-tool-btn small{font-size:11px;margin-top:7px}.stuff-tool-btn span{font:700 11px 'Space Grotesk';margin-bottom:auto}.stuff-tool-btn.journal{background:var(--lime)}.stuff-tool-btn.colorcards{background:var(--pink)}.stuff-tool-btn.saves{background:var(--aqua)}.admin-reply-note{padding:16px;border:2px solid var(--ink);border-radius:16px;background:var(--aqua);margin:18px 0}.admin-reply-note p{margin:4px 0;white-space:pre-line}
@media(max-width:700px){.ticket-style-choice,.stuff-tool-grid{grid-template-columns:1fr}.event-owner-stats{grid-template-columns:1fr 1fr}.drawer-nested{padding-left:50px}}

.admin-event-summary{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin:0 0 22px}.admin-event-summary>div{padding:18px;border:1px solid var(--line);border-radius:16px;background:#fff}.admin-event-summary b,.admin-event-summary span{display:block}.admin-event-summary strong{display:block;font:700 34px 'Space Grotesk';margin:4px 0}.admin-event-summary span{font-size:11px;color:var(--muted)}.group-admin-reply{display:flex;gap:7px;align-items:center;margin-top:8px}.group-admin-reply input{min-width:230px}@media(max-width:700px){.admin-event-summary{grid-template-columns:1fr}.group-admin-reply{flex-direction:column;align-items:stretch}.group-admin-reply input{min-width:0;width:100%}}


/* My Stuff dream UI v2 */
:root{--stuff-bg:#f7f1e5;--stuff-paper:#fffdf8;--stuff-ink:#172630;--stuff-muted:#6c767b;--stuff-line:#ded7c9;--stuff-soft:#f0eadf;--stuff-lime:#dcf56e;--stuff-aqua:#9de5db;--stuff-peach:#ffc59f;--stuff-rose:#f7b4ca;--stuff-blue:#b9d6ff;--stuff-shadow:0 24px 65px rgba(23,38,48,.09)}
body.personal-route-body{background:var(--stuff-bg)}
.personal-route-body .footer{padding-bottom:72px}
.stuff-door-v3{min-height:calc(100svh - 66px);display:grid;align-items:center;padding:34px 18px 72px;background:radial-gradient(circle at 15% 12%,rgba(220,245,110,.35),transparent 30%),radial-gradient(circle at 88% 18%,rgba(157,229,219,.32),transparent 26%),var(--stuff-bg)}
.stuff-door-v3-inner{width:min(1080px,100%);margin:auto}
.stuff-door-v3-menu{display:inline-flex;align-items:center;gap:8px;color:var(--stuff-muted);font-weight:800;font-size:12px;margin-bottom:36px}
.stuff-door-v3-mini,.cc-title>span,.journal-v4-title>span,.saves-v4-top>div>span{font-size:10px;letter-spacing:.18em;font-weight:900;text-transform:uppercase;color:var(--stuff-muted)}
.stuff-door-v3 h1{font:700 clamp(54px,10vw,104px)/.88 'Space Grotesk',sans-serif;letter-spacing:-.06em;margin:10px 0 12px}
.stuff-door-v3-sub{font-size:17px;color:var(--stuff-muted);max-width:520px;margin:0 0 30px}
.stuff-tool-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:15px}
.stuff-tool-btn{min-height:210px;padding:22px;border:2px solid var(--stuff-ink);border-radius:28px;box-shadow:8px 8px 0 var(--stuff-ink);display:flex;flex-direction:column;justify-content:flex-end;transition:transform .18s ease,box-shadow .18s ease}
.stuff-tool-btn:hover{transform:translateY(-5px);box-shadow:8px 13px 0 var(--stuff-ink)}
.stuff-tool-btn span{font:800 11px 'Space Grotesk';opacity:.7;margin-bottom:auto}.stuff-tool-btn strong{font:700 34px/1 'Space Grotesk';letter-spacing:-.04em}.stuff-tool-btn small{font-size:11px;margin-top:8px;color:#35454d}.stuff-tool-btn.journal{background:var(--stuff-lime)}.stuff-tool-btn.colorcards{background:var(--stuff-rose)}.stuff-tool-btn.saves{background:var(--stuff-aqua)}

/* Shared personal page shell */
.journal-v4,.color-cards-app,.saves-v4{width:min(1240px,100%);margin:auto;padding:30px 18px 80px}
.personal-page-back,.journal-v4-back,.cc-back,.saves-v4-back{display:inline-flex;align-items:center;gap:8px;color:var(--stuff-muted);font-size:12px;font-weight:900}
/* Journal */
.journal-v4{position:relative;display:grid;grid-template-columns:270px minmax(0,1fr);gap:24px;min-height:calc(100svh - 66px)}
.journal-v4-top{grid-column:1/-1;display:grid;grid-template-columns:auto 1fr auto;gap:20px;align-items:end;padding:12px 0 4px}
.journal-v4-title h1,.cc-title h1,.saves-v4-top h1{font:700 clamp(38px,6vw,68px)/.9 'Space Grotesk';letter-spacing:-.055em;margin:7px 0 0}
.journal-v4-stories,.cc-menu{border:1px solid var(--stuff-line);background:var(--stuff-paper);border-radius:13px;padding:10px 13px;font-weight:900;cursor:pointer}
.journal-v4-drawer{background:rgba(255,253,248,.72);border:1px solid var(--stuff-line);border-radius:24px;padding:18px;height:max-content;position:sticky;top:87px;box-shadow:0 10px 35px rgba(23,38,48,.04)}
.journal-v4-drawer-head{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:13px}.journal-v4-drawer-head strong{font:700 21px 'Space Grotesk'}.journal-v4-drawer-head button{border:0;background:var(--stuff-soft);width:34px;height:34px;border-radius:10px;font-weight:900;cursor:pointer}
.journal-v4-new{display:flex;justify-content:center;padding:11px 13px;background:var(--stuff-ink);color:#fff;border-radius:13px;font-weight:900;font-size:12px;margin-bottom:12px}.journal-v4-story-list{display:grid;gap:7px}.journal-v4-story-row{display:grid;grid-template-columns:minmax(0,1fr) 30px;gap:5px;align-items:center}.journal-v4-story{display:grid;grid-template-columns:9px 1fr;gap:10px;align-items:center;padding:10px;border-radius:13px}.journal-v4-story:hover,.journal-v4-story.active{background:#fff}.journal-v4-story i{display:block;width:9px;height:42px;border-radius:999px;background:#ddd}.journal-v4-story i.lime{background:var(--stuff-lime)}.journal-v4-story i.aqua{background:var(--stuff-aqua)}.journal-v4-story i.orange{background:var(--stuff-peach)}.journal-v4-story i.pink{background:var(--stuff-rose)}.journal-v4-story i.blue{background:var(--stuff-blue)}.journal-v4-story i.sun{background:#ffe171}.journal-v4-story i.cream{background:#ddd6c8}.journal-v4-story b{display:block;font-size:12px;line-height:1.2}.journal-v4-story small{display:block;color:var(--stuff-muted);font-size:10px;margin-top:4px}.journal-v4-story-delete button{width:28px;height:28px;border:0;border-radius:9px;background:#fff0f1;color:#b53645;font-size:18px;font-weight:900;line-height:1;cursor:pointer}.journal-v4-story-delete button:active{transform:scale(.94)}
.journal-v4-settings{display:flex;align-items:center;gap:8px;margin-top:16px;padding-top:14px;border-top:1px solid var(--stuff-line);font-size:11px;font-weight:900}.journal-v4-private{margin-top:12px;font-size:9px;letter-spacing:.12em;color:var(--stuff-muted)}
.journal-v4-main{min-width:0}.journal-v4-write{display:grid;gap:18px}.journal-v4-intro{display:flex;justify-content:space-between;gap:18px;align-items:end}.journal-v4-title-line{display:grid;gap:8px;min-width:0}.journal-v4-title-input{border:0;background:transparent;padding:0;color:var(--stuff-ink);font:700 clamp(22px,4vw,30px)/1.05 'Space Grotesk';letter-spacing:-.03em;min-width:0}.journal-v4-title-input:focus{box-shadow:none}.journal-v4-status{width:max-content;padding:6px 9px;border-radius:999px;background:#eaf1e6;font-size:9px;letter-spacing:.12em;font-weight:900;color:#5c6b5f}
.journal-v4-moods{display:flex;gap:6px;flex-wrap:wrap}.journal-v4-mood{border:1px solid var(--stuff-line);background:#fff;border-radius:999px;padding:8px 12px;font-size:11px;font-weight:900;cursor:pointer}.journal-v4-mood.active{background:var(--stuff-ink);color:#fff;border-color:var(--stuff-ink)}
.journal-v4-page,.journal-v4-book{background:var(--stuff-paper);border:1px solid var(--stuff-line);border-radius:28px;box-shadow:var(--stuff-shadow)}
.journal-v4-page{min-height:390px;padding:34px clamp(24px,5vw,62px);position:relative;overflow:hidden}.journal-v4-page:before{content:'';position:absolute;inset:0;background:linear-gradient(rgba(23,38,48,.04) 1px,transparent 1px);background-size:100% 34px;opacity:.25;pointer-events:none}.journal-v4-page>*{position:relative}.journal-v4-page-meta{display:flex;justify-content:space-between;font-size:9px;letter-spacing:.14em;color:var(--stuff-muted);font-weight:900}.journal-v4-page h2{font:700 clamp(30px,5vw,50px)/.98 'Space Grotesk';letter-spacing:-.04em;margin:55px 0 20px;max-width:780px}.journal-v4-page p{font:400 clamp(17px,2.4vw,24px)/1.72 'DM Sans';white-space:pre-wrap;color:#34444c;max-width:820px;margin:0}.journal-v4-composer{margin:0;gap:0;border:1px solid var(--stuff-line);background:#fff;border-radius:22px;overflow:visible;box-shadow:0 14px 35px rgba(23,38,48,.05)}.journal-v4-composer textarea{min-height:150px;resize:vertical;border:0;border-radius:22px 22px 0 0;padding:20px 22px;font-size:17px;line-height:1.65;background:#fff}.journal-v4-composer textarea:focus{box-shadow:none}.journal-v4-compose-bottom{position:relative;display:grid;grid-template-columns:auto 1fr auto auto;gap:9px;align-items:center;padding:9px 12px;border-top:1px solid var(--stuff-line);background:#fbfaf6;border-radius:0 0 22px 22px}.journal-v4-compose-tools{display:flex;gap:5px}.jv4-icon{display:grid;place-items:center;width:34px;height:34px;border:0;border-radius:10px;background:#eee9df;color:var(--stuff-ink);cursor:pointer;text-decoration:none}.journal-v4-compose-bottom>span{font-size:10px;color:var(--stuff-muted);padding-left:8px}.journal-v4-save{border:0;background:var(--stuff-ink);color:#fff;border-radius:11px;padding:10px 13px;font-weight:900;cursor:pointer}.journal-v4-emoji{display:none;position:absolute;left:12px;bottom:52px;gap:6px;padding:8px;background:#fff;border:1px solid var(--stuff-line);border-radius:14px;box-shadow:var(--stuff-shadow)}.journal-v4-emoji button{border:0;background:#f3eee4;border-radius:9px;padding:7px;cursor:pointer}.journal-v4-emoji-open .journal-v4-emoji{display:flex}
.journal-v4-reader{display:grid;gap:16px}.journal-v4-read-head{display:flex;justify-content:space-between;align-items:end;gap:20px}.journal-v4-read-head>div>span{font-size:9px;text-transform:uppercase;letter-spacing:.15em;font-weight:900;color:var(--stuff-muted)}.journal-v4-read-head h2{font:700 clamp(30px,5vw,54px)/.95 'Space Grotesk';letter-spacing:-.04em;margin:6px 0 0}.journal-v4-edit{border:1px solid var(--stuff-line);background:#fff;border-radius:12px;padding:9px 12px;font-size:12px;font-weight:900}.journal-v4-book{min-height:520px;padding:clamp(25px,6vw,70px);display:flex;align-items:flex-start}.journal-v4-book>div{white-space:pre-wrap;font:400 clamp(17px,2.2vw,23px)/1.85 'DM Sans';color:#34444c;max-width:850px}.journal-v4-turn{display:flex;justify-content:center;align-items:center;gap:16px}.journal-v4-turn button{width:42px;height:42px;border:1px solid var(--stuff-line);background:#fff;border-radius:13px;font-size:28px;cursor:pointer}.journal-v4-turn button:disabled{opacity:.3}.journal-v4-turn span{font-size:10px;font-weight:900;color:var(--stuff-muted);min-width:55px;text-align:center}.journal-v4-read-tools{display:flex;justify-content:center;gap:8px}.journal-v4-read-tools form,.journal-v4-read-tools button{margin:0}.journal-v4-read-tools button{border:1px solid var(--stuff-line);background:#fff;border-radius:11px;padding:9px 12px;font-size:11px;font-weight:900;cursor:pointer}.journal-v4-read-tools form:first-child button{font-size:16px;padding:7px 11px}
.journal-v4-drawer{transition:transform .22s ease}.journal-v4-open .journal-v4-drawer{box-shadow:0 24px 65px rgba(23,38,48,.14)}

/* Cards — a real visual canvas, not a form pretending to be a design tool */
.color-cards-app{display:grid;grid-template-columns:270px minmax(0,1fr);gap:24px;position:relative;min-height:calc(100svh - 66px)}
.cc-top{grid-column:1/-1;display:grid;grid-template-columns:auto 1fr auto;gap:20px;align-items:end;padding:12px 0 4px}.cc-title h1{margin-top:7px}.cc-drawer{grid-column:1;grid-row:2/5;background:rgba(255,253,248,.74);border:1px solid var(--stuff-line);border-radius:24px;padding:18px;height:max-content;position:sticky;top:87px;box-shadow:0 10px 35px rgba(23,38,48,.04)}.cc-drawer-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:12px}.cc-drawer-head div span{display:block;font-size:9px;letter-spacing:.15em;color:var(--stuff-muted);font-weight:900}.cc-drawer-head strong{font:700 27px 'Space Grotesk'}.cc-drawer-head>button{width:34px;height:34px;border:0;border-radius:10px;background:var(--stuff-soft);font-weight:900;cursor:pointer}.cc-new{width:100%;border:0;border-radius:13px;background:var(--stuff-ink);color:#fff;padding:11px;font-weight:900;cursor:pointer;margin-bottom:12px}.cc-saved-list{display:grid;gap:9px;max-height:66svh;overflow:auto;padding-right:2px}.cc-saved{display:grid;grid-template-columns:1fr auto;gap:8px;padding:8px;border:1px solid var(--stuff-line);border-radius:17px;background:#fff;align-items:center}.cc-saved-open{display:grid;grid-template-columns:30px 1fr;gap:9px;align-items:center;border:0;background:transparent;text-align:left;cursor:pointer;min-width:0}.cc-saved-open i{display:block;width:30px;height:30px;border-radius:9px;background:var(--stuff-lime);border:1px solid rgba(0,0,0,.08)}.cc-saved.blue .cc-saved-open i{background:#b7d3ff}.cc-saved.pink .cc-saved-open i{background:#f7b6ca}.cc-saved.aqua .cc-saved-open i{background:#9fe4d9}.cc-saved.orange .cc-saved-open i{background:#ffc59f}.cc-saved.yellow .cc-saved-open i{background:#ffe37a}.cc-saved-open span{font-size:11px;font-weight:900;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.cc-saved-actions{display:flex;align-items:center;gap:4px}.cc-saved-actions a{font-size:10px;font-weight:900;padding:6px 7px;border-radius:8px;background:#f5f2eb}.cc-saved-actions form{margin:0}.cc-saved-actions button{border:0;background:#fff0f1;color:#a63a49;width:26px;height:26px;border-radius:8px;font-weight:900;cursor:pointer}
.cc-main{grid-column:2;display:grid;gap:18px}.cc-hero{display:flex;justify-content:space-between;gap:20px;align-items:end}.cc-hero h2{font:700 clamp(29px,5vw,54px)/.98 'Space Grotesk';letter-spacing:-.045em;margin:8px 0;max-width:820px}.cc-hero p{margin:0;color:var(--stuff-muted);max-width:650px}.cc-surprise{border:2px solid var(--stuff-ink);background:var(--stuff-lime);padding:11px 14px;border-radius:13px;font-weight:900;white-space:nowrap;cursor:pointer;box-shadow:4px 4px 0 var(--stuff-ink)}
.cc-workspace{display:grid;grid-template-columns:minmax(0,1.12fr) minmax(320px,.88fr);gap:18px;align-items:start}.cc-preview-panel{position:sticky;top:86px;background:rgba(255,253,248,.65);border:1px solid var(--stuff-line);border-radius:26px;padding:16px}.cc-live-head{display:flex;justify-content:space-between;align-items:center;padding:4px 4px 12px;font-size:9px;letter-spacing:.15em;font-weight:900;color:var(--stuff-muted)}.cc-preview-stage{display:grid;place-items:center;min-height:560px;padding:22px;border-radius:20px;background:repeating-linear-gradient(135deg,#f2ede3 0,#f2ede3 9px,#eee8dc 9px,#eee8dc 18px);overflow:hidden}.cc-card{--cc-scale:1;position:relative;width:min(100%,560px);aspect-ratio:1/1;overflow:hidden;padding:clamp(25px,5vw,54px);display:flex;flex-direction:column;justify-content:center;gap:18px;border:3px solid var(--stuff-ink);box-shadow:10px 10px 0 var(--stuff-ink);color:var(--stuff-ink);transform:scale(var(--cc-scale));transform-origin:center;transition:all .22s ease;background:#ffe06a}.cc-card.format-square{aspect-ratio:1/1}.cc-card.format-portrait{aspect-ratio:4/5}.cc-card.format-landscape{aspect-ratio:5/3}.cc-card h3{margin:0;font:700 clamp(34px,6vw,74px)/.92 'Space Grotesk';letter-spacing:-.055em;overflow-wrap:anywhere}.cc-card p{margin:0;font:500 clamp(16px,2.2vw,25px)/1.3 'DM Sans';max-width:82%;overflow-wrap:anywhere;white-space:pre-wrap}.cc-card .cc-accent{position:absolute;right:8%;top:8%;font-size:clamp(24px,4vw,56px);opacity:.8}.cc-card .cc-brand{display:none;position:absolute;left:7%;bottom:5%;font-size:9px;letter-spacing:.15em;font-weight:900}.cc-card .cc-qr{position:absolute;right:6%;bottom:5%;width:62px;height:62px;padding:6px;background:#fff;border-radius:10px}.cc-card .cc-qr img{width:100%;height:100%;object-fit:contain}.cc-card.yellow{background:#ffe06a}.cc-card.blue{background:#b9d6ff}.cc-card.pink{background:#f6b5ca}.cc-card.aqua{background:#a0e6dc}.cc-card.lime{background:#dbf46c}.cc-card.orange{background:#ffc69e}.cc-card.teal{background:#86dad0}.cc-card.white{background:#fff}.cc-card.red{background:#ffb6b6}.cc-card.purple{background:#d7c2ff}.cc-card.navy{background:#1e4050;color:#fff}.cc-card.mint{background:#ccebdc}.cc-card.rose{background:#efb1c5}.cc-card.coral{background:#ffb39d}.cc-card.sky{background:#c2e0ff}.cc-card.ink{background:#172630;color:#fff}.cc-card.peach{background:#ffd6b7}.cc-card.lemon{background:#f4f3a2}.cc-card.violet{background:#d7bfff}.cc-card.sand{background:#e9dcc4}.cc-card.cyan{background:#9de8ea}.cc-card.magenta{background:#eeafd9}.cc-card.gradient{background:linear-gradient(135deg,#ffe06a,#ff99ba)}.cc-card.sunset{background:linear-gradient(135deg,#ffc69e,#ef9ab2)}.cc-card.ocean{background:linear-gradient(135deg,#b9d6ff,#8fd8d0)}.cc-card.aurora{background:linear-gradient(135deg,#d7c2ff,#9de5db,#ffe06a)}.cc-card.lavender{background:#eadfff}.cc-card.mintwash{background:#e1f5eb}.cc-card.dark{background:#172630;color:#fff}.cc-card.clean{background:#fff}.cc-card.paper{background:#f6f0e1}.cc-card.cream{background:#fbf6ea}.cc-card.grid{background-image:linear-gradient(rgba(23,38,48,.08) 1px,transparent 1px),linear-gradient(90deg,rgba(23,38,48,.08) 1px,transparent 1px);background-size:22px 22px}.cc-card.dots{background-image:radial-gradient(rgba(23,38,48,.14) 1px,transparent 1px);background-size:18px 18px}.cc-card.texture-soft-dots{background-image:radial-gradient(rgba(23,38,48,.08) 1px,transparent 1px);background-size:12px 12px}.cc-card.texture-lines{background-image:repeating-linear-gradient(0deg,rgba(23,38,48,.06),rgba(23,38,48,.06) 1px,transparent 1px,transparent 12px)}.cc-card.texture-grid{background-image:linear-gradient(rgba(23,38,48,.06) 1px,transparent 1px),linear-gradient(90deg,rgba(23,38,48,.06) 1px,transparent 1px);background-size:16px 16px}.cc-card.border-thin{border-width:1px;box-shadow:none}.cc-card.border-dashed{border-style:dashed}.cc-card.border-double{border-style:double;border-width:6px}.cc-card.border-none{border:0;box-shadow:none}.cc-card.rounded{border-radius:35px}.cc-card.cloud{border-radius:32% 68% 58% 42%/44% 39% 61% 56%}.cc-card.ticket{border-radius:10px;clip-path:polygon(0 0,95% 0,100% 7%,100% 93%,95% 100%,0 100%)}.cc-card.note{border-radius:10px 28px 10px 28px}.cc-card.arch{border-radius:48% 48% 15% 15%/32% 32% 15% 15%}.cc-card.pill{border-radius:999px}.cc-card.flag{clip-path:polygon(0 0,100% 0,91% 50%,100% 100%,0 100%,9% 50%)}.cc-card.diagonal{clip-path:polygon(0 8%,100% 0,100% 92%,0 100%)}.cc-card.slant{clip-path:polygon(7% 0,100% 0,93% 100%,0 100%)}.cc-card.circle{border-radius:50%;padding:18%}.cc-card.bubble{border-radius:25% 25% 25% 8%}.cc-card.softbox{border-radius:22px}.cc-card.diary{border-radius:14px;background-image:linear-gradient(90deg,rgba(23,38,48,.08) 1px,transparent 1px);background-size:32px 100%}.cc-card.stamp{border-radius:22px}.cc-card.polygon{clip-path:polygon(8% 0,92% 0,100% 12%,100% 88%,92% 100%,8% 100%,0 88%,0 12%)}.cc-card.wavy{border-radius:34% 66% 45% 55%/58% 38% 62% 42%}.cc-card.softbox{border-radius:24px}.cc-card.left{text-align:left}.cc-card.center{text-align:center;align-items:center}.cc-card.right{text-align:right;align-items:flex-end}.cc-card.center p,.cc-card.right p{max-width:90%}.cc-card.title-only p,.cc-card.body-only h3,.cc-card.empty h3,.cc-card.empty p{display:none}.cc-card.bold h3{font-weight:800}.cc-card.soft h3{font-weight:600}.cc-card.light h3{font-weight:400}.cc-card.mono h3{font-family:ui-monospace,monospace}.cc-card.serif h3{font-family:Georgia,serif}.cc-card.hand h3{font-family:'Comic Sans MS',cursive}.cc-card.display h3{letter-spacing:-.08em}.cc-card.wide h3{letter-spacing:.02em}.cc-card.typewriter h3{font-family:'Courier New',monospace}.cc-card.comic h3{font-family:'Comic Sans MS',cursive}.cc-card.caps h3{text-transform:uppercase}.cc-card.elegant h3{font-family:Georgia,serif;font-weight:500}.cc-card.custom-text h3,.cc-card.custom-text p{color:var(--cc-custom-text)}.cc-detail,.cc-tool-grid details{min-width:0}.cc-preview-actions{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:11px}.cc-preview-actions button,.cc-bottom-actions button{min-height:44px;border-radius:12px;font-weight:900;cursor:pointer}.cc-preview-actions .primary,.cc-bottom-actions .primary{background:var(--stuff-ink);color:#fff;border:0}.cc-preview-actions .secondary,.cc-bottom-actions .secondary{background:#fff;border:1px solid var(--stuff-line)}
.cc-controls{display:grid;gap:11px;margin:0}.cc-textbox,.cc-tool-grid details{border:1px solid var(--stuff-line);border-radius:18px;background:#fff;overflow:hidden}.cc-textbox{padding:15px}.cc-section-head{display:flex;justify-content:space-between;align-items:center;gap:12px}.cc-section-head>div:first-child>span,.cc-field label{font-size:9px;letter-spacing:.14em;text-transform:uppercase;color:var(--stuff-muted);font-weight:900}.cc-section-head strong{display:block;font:700 17px 'Space Grotesk';margin-top:3px}.cc-mode{display:flex;gap:4px}.cc-mode button{border:1px solid var(--stuff-line);background:#f7f4ed;border-radius:9px;padding:7px 9px;font-size:10px;font-weight:900;cursor:pointer}.cc-mode button.active{background:var(--stuff-ink);color:#fff;border-color:var(--stuff-ink)}.cc-textbox textarea{margin-top:10px;min-height:125px;border:1px solid var(--stuff-line);border-radius:12px;background:#fbfaf6;font-size:16px;line-height:1.5}.cc-textbox textarea:focus{box-shadow:none}.cc-text-hint,.cc-range-label{display:flex;justify-content:space-between;gap:10px;font-size:9px;color:var(--stuff-muted);margin-top:7px}.cc-tool-grid details summary{padding:14px 15px;list-style:none;cursor:pointer;font-size:12px;font-weight:900;display:flex;justify-content:space-between;align-items:center}.cc-tool-grid details summary::-webkit-details-marker{display:none}.cc-tool-grid details summary:after{content:'+';width:24px;height:24px;display:grid;place-items:center;background:#f1ece2;border-radius:8px;font-size:16px}.cc-tool-grid details[open] summary:after{content:'−'}.cc-tool-grid details summary span{font-size:9px;color:var(--stuff-muted);font-weight:700}.cc-detail{padding:0 15px 15px;display:grid;gap:15px;border-top:1px solid var(--stuff-line)}.cc-field{display:grid;gap:7px;padding-top:14px}.cc-swatches{display:grid;grid-template-columns:repeat(11,1fr);gap:6px}.cc-swatch{aspect-ratio:1;border-radius:9px;border:2px solid #fff;box-shadow:0 0 0 1px var(--stuff-line);cursor:pointer}.cc-swatch.yellow{background:#ffe06a}.cc-swatch.blue{background:#b9d6ff}.cc-swatch.pink{background:#f6b5ca}.cc-swatch.aqua{background:#a0e6dc}.cc-swatch.lime{background:#dbf46c}.cc-swatch.orange{background:#ffc69e}.cc-swatch.teal{background:#86dad0}.cc-swatch.white{background:#fff}.cc-swatch.red{background:#ffb6b6}.cc-swatch.purple{background:#d7c2ff}.cc-swatch.navy{background:#1e4050}.cc-swatch.mint{background:#ccebdc}.cc-swatch.rose{background:#efb1c5}.cc-swatch.coral{background:#ffb39d}.cc-swatch.sky{background:#c2e0ff}.cc-swatch.ink{background:#172630}.cc-swatch.peach{background:#ffd6b7}.cc-swatch.lemon{background:#f4f3a2}.cc-swatch.violet{background:#d7bfff}.cc-swatch.sand{background:#e9dcc4}.cc-swatch.cyan{background:#9de8ea}.cc-swatch.magenta{background:#eeafd9}.cc-swatch.active{outline:3px solid var(--stuff-ink);outline-offset:1px}.cc-chips{display:flex;flex-wrap:wrap;gap:6px}.cc-chip{border:1px solid var(--stuff-line);background:#faf8f2;border-radius:10px;padding:8px 9px;font-size:10px;font-weight:900;cursor:pointer}.cc-chip.active{background:var(--stuff-ink);color:#fff;border-color:var(--stuff-ink)}.cc-color-row{display:flex;gap:8px;align-items:center}.cc-color-row input[type=color]{width:44px;height:38px;padding:2px;border-radius:10px}.cc-range{padding:0}.cc-toggle-row{display:flex;justify-content:space-between;gap:10px;align-items:center}.cc-toggle-row label{font-size:11px;display:flex;flex-direction:row;align-items:center;gap:7px}.cc-toggle-row input{width:auto}.cc-fixed-note{font-size:9px;color:var(--stuff-muted)}.cc-bottom-actions{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px}.cc-lock{min-height:70svh;display:grid;place-items:center;text-align:center;padding:50px 20px}.cc-lock h2{font:700 40px/.98 'Space Grotesk';max-width:600px;margin:15px 0}.cc-lock p{color:var(--stuff-muted);max-width:600px}.cc-lock button{border:0;background:var(--stuff-ink);color:#fff;border-radius:13px;padding:12px 16px;font-weight:900;cursor:pointer}

/* My Saves — intentionally quiet and list-first */
.saves-v4{min-height:calc(100svh - 66px)}.saves-v4-top{display:grid;grid-template-columns:auto 1fr auto;gap:20px;align-items:end;padding:12px 0 24px}.saves-v4-top h1{margin-top:7px}.saves-v4-top-actions{display:flex;gap:7px;align-items:center}.saves-v4-search-button{width:42px;height:42px;border:1px solid var(--stuff-line);background:#fff;border-radius:12px;cursor:pointer;font-size:20px}.saves-v4-search{margin-bottom:12px}.saves-v4-search input{border-radius:15px;background:#fff;border:1px solid var(--stuff-line);padding:14px 15px}.saves-v4-search input:focus{box-shadow:none}.saves-v4-list{display:grid;gap:7px}.saves-v4-row{display:grid;grid-template-columns:minmax(130px,.7fr) minmax(0,1.4fr) auto auto;align-items:center;gap:7px;background:#fff;border:1px solid var(--stuff-line);border-radius:15px;padding:8px 10px;min-height:56px}.saves-v4-name,.saves-v4-value{border:0;background:transparent;text-align:left;min-width:0;padding:7px;cursor:pointer;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.saves-v4-name{font-weight:900}.saves-v4-value{font-family:ui-monospace,monospace;color:#425159}.saves-v4-value.is-hidden{letter-spacing:.18em}.saves-v4-reveal{border:0;background:transparent;color:var(--stuff-muted);font-weight:900;font-size:10px;cursor:pointer;padding:8px}.saves-v4-actions{display:flex;align-items:center;gap:4px}.saves-v4-actions a{font-size:10px;font-weight:900;padding:7px 8px;background:#f6f2ea;border-radius:9px}.saves-v4-actions form{margin:0}.saves-v4-actions button{border:0;background:#fff0f1;color:#a63a49;width:28px;height:28px;border-radius:8px;font-weight:900;cursor:pointer}.saves-v4-copy-state{grid-column:1/-1;font-size:9px;color:#568467;padding-left:7px;min-height:11px}.saves-v4-plus{position:fixed;right:20px;bottom:24px;z-index:40;width:58px;height:58px;border:2px solid var(--stuff-ink);border-radius:18px;background:var(--stuff-lime);font-size:30px;font-weight:900;box-shadow:6px 6px 0 var(--stuff-ink);cursor:pointer}.saves-v4-sheet{position:fixed;inset:auto 0 0;z-index:100;display:none;background:#fffdf8;border-top:1px solid var(--stuff-line);box-shadow:0 -25px 70px rgba(23,38,48,.16);padding:18px 18px 28px}.saves-v4-sheet.open{display:block}.saves-v4-sheet>div{display:flex;justify-content:space-between;align-items:center}.saves-v4-sheet>div>span{font-size:9px;letter-spacing:.15em;font-weight:900;color:var(--stuff-muted)}.saves-v4-sheet>div>button{border:0;background:#eee9df;width:36px;height:36px;border-radius:10px;font-weight:900}.saves-v4-sheet form{margin-top:14px}.saves-v4-save{border:0;background:var(--stuff-ink);color:#fff;border-radius:13px;padding:13px;font-weight:900;cursor:pointer}

/* Ticketing owner persistence + visitor polish */
.event-owner-bar{max-width:1300px;margin:18px auto 0;padding:12px 14px;background:#fff;border:1px solid var(--line);border-radius:14px;display:flex;justify-content:space-between;align-items:center;gap:14px}.event-owner-bar b{font-size:12px}.event-owner-bar span{display:block;color:var(--muted);font-size:10px;margin-top:2px}.event-owner-bar>div:last-child{display:flex;gap:7px;flex-wrap:wrap}
.owner-event-card{position:relative}.owner-event-card:after{content:'MANAGE';position:absolute;top:10px;right:10px;background:var(--lime);border:1px solid var(--ink);border-radius:999px;padding:5px 8px;font-size:8px;font-weight:900;letter-spacing:.08em}
.event-manage-link{display:inline-flex;align-items:center;gap:8px;padding:9px 11px;border:1px solid var(--line);border-radius:11px;background:#fff;font-size:11px;font-weight:900}

/* More destinations / travel rail */
.destination-grid{grid-template-columns:repeat(4,1fr)}
.destination-image span{position:absolute;left:13px;bottom:13px;z-index:2;background:rgba(18,33,43,.86);color:#fff;padding:6px 8px;border-radius:999px;font-size:9px;font-weight:900}

@media(max-width:1050px){.stuff-tool-grid{grid-template-columns:1fr}.journal-v4,.color-cards-app{grid-template-columns:1fr}.journal-v4-top,.cc-top{grid-column:1;grid-template-columns:auto 1fr auto}.journal-v4-drawer,.cc-drawer{grid-column:1;grid-row:auto;position:fixed;left:0;top:66px;bottom:0;width:min(360px,92vw);z-index:90;transform:translateX(-105%);transition:transform .22s ease;overflow:auto;background:#f8f2e7;box-shadow:20px 0 55px rgba(23,38,48,.12)}.journal-v4-open .journal-v4-drawer,.cc-drawer-open .cc-drawer{transform:translateX(0)}.journal-v4-main,.cc-main{grid-column:1}.cc-workspace{grid-template-columns:1fr}.cc-preview-panel{position:relative;top:auto}.cc-preview-stage{min-height:500px}.destination-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:700px){.journal-v4,.color-cards-app,.saves-v4{padding:22px 14px 85px}.stuff-door-v3{padding:28px 14px 65px}.stuff-door-v3 h1{font-size:64px}.stuff-tool-btn{min-height:165px}.journal-v4-top,.cc-top,.saves-v4-top{grid-template-columns:auto 1fr auto;gap:10px}.journal-v4-title h1,.cc-title h1,.saves-v4-top h1{font-size:36px}.journal-v4-intro,.cc-hero{display:grid;align-items:start}.journal-v4-stories,.cc-menu{padding:8px 9px;font-size:10px}.journal-v4-page{min-height:360px;padding:28px 21px}.journal-v4-page h2{margin-top:43px}.journal-v4-page p{font-size:17px}.journal-v4-compose-bottom{grid-template-columns:auto 1fr auto}.journal-v4-compose-bottom>span{padding-left:3px}.journal-v4-save{padding:10px 11px;font-size:11px}.cc-hero h2{font-size:33px}.cc-surprise{justify-self:start}.cc-preview-stage{min-height:410px;padding:12px}.cc-card{width:min(100%,430px);padding:29px}.cc-card h3{font-size:clamp(33px,10vw,55px)}.cc-card p{font-size:15px}.cc-bottom-actions{grid-template-columns:1fr 1fr}.cc-bottom-actions .ghost{grid-column:1/-1}.cc-swatches{grid-template-columns:repeat(8,1fr)}.saves-v4-top{align-items:end}.saves-v4-top-actions .button{padding:8px 9px}.saves-v4-row{grid-template-columns:minmax(88px,.75fr) minmax(0,1fr) auto}.saves-v4-actions{grid-column:2/-1;justify-content:end}.saves-v4-plus{right:15px;bottom:15px}.event-owner-bar{margin:12px 14px;display:grid}.destination-grid{grid-template-columns:1fr}.destination-image{height:220px}}

/* My Stuff v5 refinements */
.cc-preset-row{display:grid;grid-template-columns:repeat(4,1fr);gap:6px}.cc-preset{border:1px solid var(--stuff-line);background:#f7f4ed;border-radius:11px;padding:10px 8px;font-size:10px;font-weight:900;cursor:pointer}.cc-preset:hover{background:var(--stuff-ink);color:#fff}.cc-format-chips .cc-chip{min-width:0}.journal-v4-lock{display:flex;align-items:center;gap:8px;margin-top:8px;font-size:11px;font-weight:900;color:var(--stuff-muted)}.journal-v4-lock:hover{color:var(--stuff-ink)}.journal-local-save{font-size:9px;color:var(--stuff-muted);white-space:nowrap}
@media(max-width:700px){.cc-preset-row{grid-template-columns:repeat(2,1fr)}.cc-preview-panel{padding:10px}.cc-live-head{padding-bottom:8px}.cc-preview-stage{min-height:390px}.cc-card{max-width:100%;box-shadow:7px 7px 0 var(--stuff-ink)}.journal-v4-compose-bottom{gap:6px}.journal-local-save{display:none}}

.places-more-note{grid-column:1/-1;margin-top:8px;padding:18px 20px;border:1px solid rgba(255,255,255,.18);border-radius:18px;background:#172934;display:grid;grid-template-columns:auto 1fr auto;gap:16px;align-items:center}.places-more-note span{font-size:9px;letter-spacing:.16em;font-weight:900;color:#9fd7cf}.places-more-note b{font:700 18px/1.15 "Space Grotesk";color:#fff}.places-more-note a{font-size:11px;font-weight:900;color:#fff;border-bottom:1px solid rgba(255,255,255,.35)}@media(max-width:700px){.places-more-note{grid-template-columns:1fr;padding:16px}.places-more-note b{font-size:16px}}

.cc-card.custom-solid{background:var(--cc-custom-bg)}.cc-card>*{position:relative;z-index:1}.cc-card:before{content:"";position:absolute;z-index:0;pointer-events:none}.cc-card.sunny:before{width:160px;height:160px;right:-25px;top:-25px;border-radius:50%;background:rgba(255,255,255,.22);box-shadow:-45px 55px 0 rgba(255,139,76,.12)}.cc-card.editorial:before{left:7%;right:7%;top:17%;height:2px;background:rgba(23,38,48,.20);box-shadow:0 12px 0 rgba(23,38,48,.10)}.cc-card.poster:before{right:7%;top:7%;width:24%;height:24%;background:rgba(23,38,48,.10);transform:rotate(8deg);box-shadow:-250px 480px 0 rgba(255,139,76,.10)}.cc-card.minimal:before{left:8%;top:10%;width:24%;height:5px;background:rgba(23,38,48,.28);border-radius:99px}.cc-card.playful:before{width:180px;height:180px;right:-35px;top:-40px;border-radius:50%;background:rgba(255,255,255,.20);box-shadow:-330px 430px 0 rgba(119,225,210,.18),-100px 390px 0 rgba(255,143,182,.15)}.cc-card.night:before{inset:-20%;background:radial-gradient(circle at 82% 18%,rgba(185,214,255,.35),transparent 24%),radial-gradient(circle at 18% 82%,rgba(157,229,219,.22),transparent 22%)}

/* Journal settings / lock screens — same quiet personal-space language */
.journal-settings-screen{min-height:calc(100svh - 66px);padding:34px 18px 80px;background:var(--stuff-bg);display:grid;place-items:start center}.journal-my-stuff{width:min(820px,100%);color:var(--stuff-muted);font-size:12px;font-weight:900;margin-bottom:18px}.journal-settings-card{width:min(820px,100%);background:var(--stuff-paper);border:1px solid var(--stuff-line);border-radius:28px;box-shadow:var(--stuff-shadow);padding:clamp(24px,6vw,60px)}.journal-settings-card>span{font-size:10px;letter-spacing:.18em;color:var(--stuff-muted);font-weight:900}.journal-settings-card h1{font:700 clamp(40px,7vw,70px)/.92 'Space Grotesk';letter-spacing:-.055em;margin:10px 0 14px}.journal-settings-card>p{max-width:650px;color:var(--stuff-muted);font-size:16px}.journal-setting-status{margin:18px 0;padding:12px 14px;border-radius:13px;background:#eaf4df;font-size:12px;font-weight:900}.journal-secret-form,.journal-settings-card form{display:grid;gap:11px}.journal-settings-card input,.journal-settings-card select{background:#fff;border:1px solid var(--stuff-line)}.journal-save,.journal-soft{border:0;border-radius:13px;padding:12px 15px;font-weight:900;cursor:pointer}.journal-save{background:var(--stuff-ink);color:#fff}.journal-soft{background:#eee9df;color:var(--stuff-ink)}.journal-appearance-tools{margin-top:24px;padding-top:20px;border-top:1px solid var(--stuff-line);display:grid;gap:13px}.journal-appearance-tools label{font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:var(--stuff-muted)}.journal-appearance-tools small,.journal-settings-card>small{font-size:10px;color:var(--stuff-muted)}.journal-locked-screen{min-height:calc(100svh - 66px);display:grid;place-items:center;padding:35px 18px;background:var(--stuff-bg)}.journal-lock-card{width:min(560px,100%);padding:clamp(26px,7vw,58px);background:var(--stuff-paper);border:1px solid var(--stuff-line);border-radius:28px;box-shadow:var(--stuff-shadow);text-align:left}.journal-lock-card>span{display:grid;place-items:center;width:52px;height:52px;border-radius:16px;background:var(--stuff-lime);font-size:23px}.journal-lock-card h1{font:700 clamp(38px,7vw,60px)/.94 'Space Grotesk';letter-spacing:-.05em;margin:20px 0 10px}.journal-lock-card p{color:var(--stuff-muted)}.journal-lock-card form{display:grid;gap:11px;margin-top:22px}.journal-lock-card input{background:#fff}.journal-lock-card button{border:0;border-radius:13px;padding:13px;background:var(--stuff-ink);color:#fff;font-weight:900;cursor:pointer}.journal-lock-card>a{display:inline-block;margin-top:15px;font-size:11px;font-weight:900;color:var(--stuff-muted)}

/* My Stuff v5 — quiet, spacious personal tools */
.journal-v5{min-height:calc(100svh - 66px);display:grid;grid-template-columns:300px minmax(0,1fr);background:var(--stuff-bg)}
.journal-v5-side{background:rgba(255,253,248,.76);border-right:1px solid var(--stuff-line);padding:24px 18px;display:flex;flex-direction:column;gap:14px;position:sticky;top:66px;height:calc(100svh - 66px);overflow:auto}.j5-side-top{display:flex;justify-content:space-between;align-items:center}.j5-back{font-size:11px;font-weight:900;color:var(--stuff-muted)}.j5-close{display:none;border:0;background:var(--stuff-soft);width:34px;height:34px;border-radius:10px;font-weight:900}.j5-side-title span{display:block;font-size:9px;letter-spacing:.17em;font-weight:900;color:var(--stuff-muted)}.j5-side-title strong{display:block;font:700 26px/1 'Space Grotesk';margin-top:5px}.j5-new{display:flex;justify-content:center;padding:12px;border-radius:13px;background:var(--stuff-ink);color:#fff;font-weight:900;font-size:11px}.j5-pages{display:grid;gap:5px}.j5-page-row{display:grid;grid-template-columns:minmax(0,1fr) 30px;gap:4px;align-items:center}.j5-page-row>a{display:grid;grid-template-columns:8px 1fr;gap:10px;align-items:center;padding:10px;border-radius:12px;min-width:0}.j5-page-row>a:hover,.j5-page-row.active>a{background:#fff}.j5-page-row i{width:8px;height:38px;border-radius:999px;background:#ddd6c8}.j5-page-row i.lime{background:#dff273}.j5-page-row i.aqua{background:#9de6da}.j5-page-row i.orange{background:#ffc39d}.j5-page-row i.pink{background:#f6b4ca}.j5-page-row i.blue{background:#b8d5ff}.j5-page-row i.sun{background:#ffe171}.j5-page-row b{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:11px}.j5-page-row small{display:block;color:var(--stuff-muted);font-size:9px;margin-top:4px}.j5-page-row form{margin:0}.j5-page-row form button{border:0;width:28px;height:28px;background:#fff0f1;color:#a63a49;border-radius:8px;font-weight:900}.j5-empty{color:var(--stuff-muted);font-size:11px;padding:8px}.j5-side-foot{margin-top:auto;padding-top:14px;border-top:1px solid var(--stuff-line);display:flex;justify-content:space-between;gap:10px;font-size:10px;color:var(--stuff-muted)}.j5-side-foot a{font-weight:900;color:var(--stuff-ink)}.j5-title-editor{padding-top:14px;border-top:1px solid var(--stuff-line)}.j5-title-editor label{display:block;font-size:9px;font-weight:900;letter-spacing:.14em;color:var(--stuff-muted);margin-bottom:6px}.j5-title-editor input{width:100%;border:0;border-bottom:1px solid var(--stuff-line);border-radius:0;background:transparent;padding:7px 0;font-weight:800}.j5-title-editor input:focus{box-shadow:none;border-color:var(--stuff-ink)}
.journal-v5-main{min-width:0;min-height:calc(100svh - 66px);display:flex;flex-direction:column}.j5-header{display:grid;grid-template-columns:50px 1fr 50px;align-items:center;padding:18px 24px 10px}.j5-menu{border:1px solid var(--stuff-line);background:#fff;width:42px;height:42px;border-radius:12px;font-size:18px}.j5-header-center{text-align:center}.j5-header-center span{font-size:9px;letter-spacing:.18em;font-weight:900;color:var(--stuff-muted)}.j5-header-center h1{font:700 clamp(34px,6vw,58px)/.92 'Space Grotesk';letter-spacing:-.05em;margin:5px 0 0}.j5-header-actions{text-align:right}.j5-header-actions a{font-size:18px;color:var(--stuff-muted)}
.j5-compose{flex:1;display:flex;flex-direction:column;min-height:0;padding:20px clamp(18px,5vw,72px) 24px}.j5-compose-title{display:flex;justify-content:space-between;gap:16px;align-items:center;border-bottom:1px solid var(--stuff-line);padding:0 0 12px}.j5-compose-title span{font:700 clamp(20px,3vw,30px)/1.05 'Space Grotesk';letter-spacing:-.03em;color:var(--stuff-ink)}.j5-title-main{flex:1;min-width:0;border:0;border-bottom:1px solid transparent;border-radius:0;background:transparent;padding:0;color:var(--stuff-ink);font:700 clamp(20px,3vw,30px)/1.05 'Space Grotesk';letter-spacing:-.03em}.j5-title-main::placeholder{color:#a7a9a6}.j5-title-main:focus{border-bottom-color:var(--stuff-line);box-shadow:none}.j5-compose-title em{font-style:normal;font-size:10px;color:var(--stuff-muted);white-space:nowrap}.j5-compose>textarea{flex:1;min-height:58svh;width:100%;border:0;outline:0;resize:none;background:transparent;padding:38px 0;font:400 clamp(19px,2.3vw,27px)/1.85 'DM Sans';color:#2f4048}.j5-compose>textarea::placeholder{color:#a7a9a6}.j5-compose>textarea:focus{box-shadow:none}.j5-bottom{display:flex;justify-content:space-between;align-items:center;border-top:1px solid var(--stuff-line);padding-top:12px}.j5-bottom-left{display:flex;align-items:center;gap:10px;color:var(--stuff-muted)}.j5-bottom-left button{border:0;background:#f0eadf;width:36px;height:36px;border-radius:10px}.j5-bottom-left span{font-size:10px}.j5-save{border:0;background:var(--stuff-ink);color:#fff;border-radius:12px;padding:11px 16px;font-weight:900}
.j5-reader{flex:1;padding:24px clamp(18px,7vw,110px) 60px}.j5-reader-meta{display:flex;justify-content:space-between;align-items:center;font-size:10px;color:var(--stuff-muted);font-weight:900}.j5-reader-meta a{background:#fff;border:1px solid var(--stuff-line);padding:8px 10px;border-radius:10px;color:var(--stuff-ink)}.j5-reader h2{font:700 clamp(36px,7vw,74px)/.94 'Space Grotesk';letter-spacing:-.05em;margin:42px 0 26px;max-width:920px}.j5-reading{white-space:pre-wrap;max-width:900px;font:400 clamp(19px,2.2vw,27px)/1.9 'DM Sans';color:#35464e;min-height:52svh}.j5-reader-tools{display:flex;gap:8px;justify-content:center;padding-top:28px}.j5-reader-tools button{border:1px solid var(--stuff-line);background:#fff;border-radius:11px;padding:9px 12px;font-weight:900}.j5-reader-tools form:first-child button{font-size:18px}
@media(max-width:900px){.journal-v5{grid-template-columns:1fr}.journal-v5-side{position:fixed;z-index:120;left:0;top:0;width:min(330px,90vw);height:100svh;transform:translateX(-105%);transition:transform .2s ease;box-shadow:18px 0 50px rgba(23,38,48,.14)}.journal-v5-open .journal-v5-side{transform:translateX(0)}.j5-close{display:block}.journal-v5-main{min-height:100svh}.j5-header{padding:14px 14px 8px}.j5-compose{padding:16px 18px 20px}.j5-compose>textarea{min-height:60svh;padding:30px 0}.j5-reader{padding:18px 18px 50px}.j5-reader h2{margin-top:30px}}
.saves-v5{width:min(1180px,100%);margin:auto;min-height:calc(100svh - 66px);padding:28px 18px 90px}.s5-header{display:grid;grid-template-columns:auto 1fr auto;gap:18px;align-items:end}.s5-header>a{font-size:11px;font-weight:900;color:var(--stuff-muted)}.s5-header span{font-size:9px;letter-spacing:.18em;font-weight:900;color:var(--stuff-muted)}.s5-header h1{font:700 clamp(38px,6vw,62px)/.94 'Space Grotesk';letter-spacing:-.055em;margin:7px 0 0}.s5-actions{display:flex;gap:6px}.s5-actions button,.s5-actions a{border:1px solid var(--stuff-line);background:#fff;border-radius:11px;padding:9px 11px;font-weight:900;font-size:11px}.s5-tools{display:flex;gap:8px;align-items:center;margin:25px 0 10px}.s5-tools input{flex:1;border:1px solid var(--stuff-line);border-radius:13px;background:#fff;padding:13px}.s5-tools button{border:1px solid var(--stuff-line);background:#fff;border-radius:13px;padding:12px 13px;font-weight:900}.s5-list{display:grid;gap:5px}.s5-row{display:grid;grid-template-columns:minmax(150px,1fr) 1px minmax(0,1.5fr) auto auto;gap:14px;align-items:center;width:100%;min-height:56px;padding:8px 12px;background:#fff;border:1px solid var(--stuff-line);border-radius:13px}.s5-name{font-size:12px;font-weight:900;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.s5-divider{width:1px;height:32px;background:var(--stuff-line)}.s5-value{border:0;background:transparent;text-align:left;font:500 12px ui-monospace,monospace;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;cursor:pointer;color:#46575f;min-width:0}.s5-value.mode-0{letter-spacing:.18em}.s5-edit{font-size:10px;font-weight:900;padding:7px 8px;border-radius:8px;background:#f4f0e8;white-space:nowrap}.s5-delete{border:0;background:#fff0f1;color:#a63a49;width:28px;height:28px;border-radius:8px;font-weight:900}.s5-plus{position:fixed;right:20px;bottom:22px;width:58px;height:58px;border:2px solid var(--stuff-ink);background:var(--stuff-lime);border-radius:18px;font-size:30px;font-weight:900;box-shadow:6px 6px 0 var(--stuff-ink)}.s5-empty{text-align:center;padding:70px 20px;color:var(--stuff-muted);display:grid;gap:6px}.s5-empty b{font:700 24px 'Space Grotesk';color:var(--stuff-ink)}.s5-dialog{width:min(520px,92vw);border:1px solid var(--stuff-line);border-radius:24px;background:#fffdf8;padding:24px;box-shadow:0 25px 70px rgba(23,38,48,.2)}.s5-dialog::backdrop{background:rgba(23,38,48,.26)}.s5-dialog>span{font-size:9px;letter-spacing:.16em;color:var(--stuff-muted);font-weight:900}.s5-dialog h3{font:700 34px/1 'Space Grotesk';margin:8px 0 18px}.s5-dialog form{display:grid;gap:11px}.s5-dialog label{display:grid;gap:6px;font-size:10px;letter-spacing:.08em;text-transform:uppercase;color:var(--stuff-muted);font-weight:900}.s5-dialog input{background:#fff}.s5-dialog form button{border:0;background:var(--stuff-ink);color:#fff;border-radius:12px;padding:12px;font-weight:900}.s5-x{position:absolute;right:14px;top:14px;border:0;background:#eee9df;width:34px;height:34px;border-radius:10px;font-weight:900}.s5-lock{max-width:580px;margin:14vh auto 0;padding:40px;background:var(--stuff-paper);border:1px solid var(--stuff-line);border-radius:28px;box-shadow:var(--stuff-shadow)}.s5-lock-icon{width:50px;height:50px;border-radius:15px;background:var(--stuff-lime);display:grid;place-items:center;font-size:23px}.s5-lock span{display:block;margin-top:18px;font-size:9px;letter-spacing:.16em;color:var(--stuff-muted);font-weight:900}.s5-lock h2{font:700 clamp(34px,6vw,52px)/.96 'Space Grotesk';letter-spacing:-.04em;margin:9px 0}.s5-lock p{color:var(--stuff-muted)}.s5-lock form{display:grid;grid-template-columns:1fr auto;gap:8px;margin-top:18px}.s5-lock form button{border:0;background:var(--stuff-ink);color:#fff;border-radius:12px;padding:12px 16px;font-weight:900}@media(max-width:700px){.saves-v5{padding:20px 12px 88px}.s5-header{grid-template-columns:auto 1fr auto;gap:10px}.s5-header h1{font-size:38px}.s5-row{grid-template-columns:minmax(92px,.8fr) 1px minmax(120px,1.2fr) auto auto;gap:8px;padding:7px 8px}.s5-edit{padding:6px}.s5-delete{width:26px;height:26px}.s5-lock{margin:10vh 0 0;padding:28px 20px}.s5-lock form{grid-template-columns:1fr}.s5-tools{margin-top:18px}}
